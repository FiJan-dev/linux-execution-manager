# copie este arquivo para ".env" e ajuste os valores

# conexão com o MySQL (usuário:senha@servidor:porta/banco)
DATABASE_URL="mysql://usuario:senha@localhost:3306/ambientes"

# pasta dos scripts enviados e dos logs (se não definir, usa ./dados)
# na VM: /var/lib/lem
# LEM_DADOS="/var/lib/lem"

# caminho do script de execução (se não definir, usa /opt/lem/ambiente.sh)
# LEM_SCRIPT="/opt/lem/ambiente.sh"

# execução falsa, só para o PC (não tem cgroup nem namespace)
# no PC: tire o "#" da linha abaixo
# na VM: não definir esta variável
# EXECUCAO_FALSA="true"